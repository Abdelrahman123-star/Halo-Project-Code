{
  "expo": {
    "name": "HALO",
    "slug": "halo",
    "scheme": "halo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F2EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "HALO needs access to your photo library to let you upload clothing images for analysis.",
          "cameraPermission": "HALO needs access to your camera to let you photograph clothing for analysis."
        }
      ],
      "expo-asset"
    ]
  }
}
