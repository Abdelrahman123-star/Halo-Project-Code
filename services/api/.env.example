# Roboflow API key — get yours at https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_MODEL_ID=deepfashion2-m-10k/2

# Supabase public URL + anon key for Bearer JWT verification & RLS-forwarded persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Allowed CORS origins (JSON array format)
CORS_ORIGINS=["http://localhost:8081", "http://localhost:19006", "http://localhost:3000"]
