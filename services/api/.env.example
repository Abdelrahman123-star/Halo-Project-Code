ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_MODEL_ID=deepfashion2-m-10k/2

# Supabase (BACKEND ONLY). Dashboard → Project Settings → API.
# The service-role key bypasses Row Level Security: never put it in apps/mobile/.env,
# never commit it, never log it. The mobile app only ever gets the anon key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Public anon key (same as apps/mobile). Enough to verify logins; without the service-role key
# the server returns results but does not save them (the app keeps them on the device).
SUPABASE_ANON_KEY=your_anon_key_here

# Optional: where the MediaPipe .task files live (default: services/api/models)
# AVATAR_MODELS_DIR=

# Allowed CORS origins (JSON array format). Native apps don't use CORS; this is for browser tools.
CORS_ORIGINS=["http://localhost:8081", "http://localhost:19006", "http://localhost:3000"]
